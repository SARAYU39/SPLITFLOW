# SplitFlow environment variables
# Copy this file to ".env" and fill in your own Supabase project values.
# Find both under Supabase dashboard → Project Settings → API.
#
# Note: these VITE_ prefixed vars are for a Vite project. If you use Next.js,
# rename them to NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Do NOT put your service_role key here or anywhere in client code —
# it bypasses Row-Level Security and must stay server-side only.
